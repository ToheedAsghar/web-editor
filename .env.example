# Neon Postgres — pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon Postgres — direct (unpooled) connection string, used only for
# `prisma migrate`. Prisma migrations fail against Neon's pooled connection.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Separate Neon branch, used only by the Vitest integration test suite.
# Never point this at the production or dev database.
TEST_DATABASE_URL="postgresql://user:password@ep-example-test.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign/verify session JWTs. Generate with:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-random-32-byte-secret"
